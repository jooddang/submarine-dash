# API Configuration
# For local development, this points to the local backend
# For production (Vercel), this is not needed - API calls use relative paths
# VITE_API_URL=http://localhost:3001

# Redis Database (Required for production)
# Get this from your Redis provider (RedisLabs, Upstash, etc.)
# Format: redis://default:PASSWORD@HOST:PORT
REDIS_URL=redis://default:your-password@your-redis-host:port

# Migration rollout controls (all new behavior defaults off)
SD_LEGACY_STORAGE_ENABLED=true
SD_SUPABASE_SHADOW_VERIFY=false
SD_MIGRATION_ADMISSION_GATE_ENABLED=false
SD_CANONICAL_AUTH_TICKETS_ENABLED=false
SD_PROTECTED_ACCOUNT_CANARY_ENABLED=false
SD_MIGRATION_ROLLBACK_MODE=false
# Canonical auth trust boundary. Keep the internal credential server-only and
# use localhost overrides only outside production.
SD_SUBMARINE_PUBLIC_ORIGIN=https://submarine-dash.roadcrosser.com
SD_ROADCROSSER_PUBLIC_ORIGIN=https://www.roadcrosser.com
SD_ROADCROSSER_INTERNAL_BASE_URL=https://www.roadcrosser.com
SD_ROADCROSSER_INTERNAL_AUTH_TOKEN=replace-with-at-least-32-random-characters
# Must exceed the maximum server invocation duration plus safety margin.
SD_MIGRATION_LEASE_TTL_MS=930000
# Required by operator preflight and freeze commands. Every URL must be an HTTPS
# health endpoint for a deployed runtime participating in the freeze.
SD_MIGRATION_RUNTIME_PROBE_URLS=https://submarine-dash.example.com/api/health
SD_MIGRATION_EXPECTED_DEPLOYED_COMMIT=replace-with-deployed-git-sha
# Freeze waits longer than the configured lease TTL. The default is 1000000ms
# (930000ms TTL plus a 70000ms safety margin); accepted maximum is 1800000ms.
SD_MIGRATION_FREEZE_DRAIN_TIMEOUT_MS=1000000
# Poll interval must be 50-10000ms and no greater than the drain timeout.
SD_MIGRATION_FREEZE_POLL_INTERVAL_MS=1000
# Stale-PVP quarantine accepts the sealed archive and 32-byte key only through
# inherited, already-open descriptors. Never place paths or key bytes in env.
SD_MIGRATION_QUARANTINE_ARCHIVE_FD=3
SD_MIGRATION_QUARANTINE_KEY_FD=4
SD_MIGRATION_QUARANTINE_RESTORE_REPORT_FD=5
SD_MIGRATION_QUARANTINE_ARCHIVE_SHA256=replace-with-approved-sealed-archive-sha256
SD_MIGRATION_QUARANTINE_MANIFEST_CHECKSUM=replace-with-approved-manifest-sha256
SD_MIGRATION_QUARANTINE_RESTORE_REPORT_SHA256=replace-with-approved-restore-report-sha256
SD_MIGRATION_QUARANTINE_ARCHIVE_APPLICATION_COMMIT=replace-with-exact-precleanup-application-commit
SD_MIGRATION_QUARANTINE_CUTOFF_MS=replace-with-explicit-unix-ms
SD_MIGRATION_EXPECTED_FROZEN_EPOCH=replace-with-exact-gate-epoch
